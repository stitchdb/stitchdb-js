{
  "name": "stitchdb-js",
  "version": "1.0.2",
  "description": "Official JavaScript client for StitchDB: database, auth, storage and realtime.",
  "license": "MIT",
  "homepage": "https://stitchdb.com/docs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "stitchdb",
    "postgres",
    "database",
    "auth",
    "realtime",
    "storage"
  ],
  "scripts": {
    "build": "sh build.sh",
    "prepublishOnly": "sh build.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.49.4",
    "esbuild": "0.24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stitchdb/stitchdb-js.git"
  },
  "bugs": "https://github.com/stitchdb/stitchdb-js/issues"
}
