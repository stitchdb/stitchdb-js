{
  "name": "stitchdb-js",
  "version": "2.5.0",
  "description": "Official JavaScript and TypeScript client for StitchDB: database, auth, storage, realtime and Edge Functions.",
  "license": "MIT",
  "homepage": "https://stitchdb.com/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stitchdb/stitchdb-js.git"
  },
  "bugs": "https://github.com/stitchdb/stitchdb-js/issues",
  "keywords": [
    "stitchdb",
    "postgres",
    "database",
    "auth",
    "realtime",
    "storage",
    "edge-functions",
    "postgrest"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/stitchdb.js",
  "jsdelivr": "./dist/stitchdb.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cors": {
      "types": "./dist/types/cors.d.ts",
      "import": "./dist/cors.mjs",
      "require": "./dist/cors.cjs"
    },
    "./middleware": {
      "types": "./dist/types/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.cjs"
    },
    "./tracing": {
      "types": "./dist/types/tracing.d.ts",
      "import": "./dist/tracing.mjs",
      "require": "./dist/tracing.cjs"
    },
    "./jobs": {
      "types": "./dist/types/jobs.d.ts",
      "import": "./dist/jobs.mjs",
      "require": "./dist/jobs.cjs"
    },
    "./sql": {
      "types": "./dist/types/sql.d.ts",
      "import": "./dist/sql.mjs",
      "require": "./dist/sql.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.js",
    "dist/types",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "sideEffects": [
    "./dist/tracing.cjs",
    "./dist/tracing.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "iceberg-js": "^0.8.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^20.19.9",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3"
  }
}
